<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net481</TargetFramework>
    <RootNamespace>VDBDbTest</RootNamespace>
    <AssemblyName>VDB-DBTest</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
  </PropertyGroup>
  <Import Project="..\VDBBase\environment.props" />
  <ItemGroup>
    <Reference Include="Jotunn, Version=2.27.0.0, Culture=neutral, processorArchitecture=MSIL">
      <HintPath>..\VDB-Auth\packages\JotunnLib.2.27.0\lib\net462\Jotunn.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(CorlibPath)\UnityEngine.CoreModule.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(CorlibPath)\UnityEngine.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\VDBBase\VDB-Base.csproj" />
    <ProjectReference Include="..\VDB-Auth\VDB-Auth.csproj" />
  </ItemGroup>
  <!-- Referenced mod projects ILRepack to disk as *.dll but assembly identity stays *.merged. -->
  <Target Name="CopyMergedAssemblyAliases" AfterTargets="Build">
    <Copy SourceFiles="$(TargetDir)VDB-Base.dll" DestinationFiles="$(TargetDir)VDB-Base.merged.dll" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(TargetDir)DrakesVDB-Auth.dll" DestinationFiles="$(TargetDir)DrakesVDB-Auth.merged.dll" SkipUnchangedFiles="true" />
  </Target>
</Project>
